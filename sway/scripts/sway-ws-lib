# Shared helpers for the workspace scripts. Sourced, not run.
#
# Workspace names are "<number>:<label>", where label may lead with an icon.
# The number is the keyboard slot; sway matches `workspace number N` on it and
# ignores the label, which is what lets labels be renamed freely.

MRU_STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sway-ws-mru"
FUZZEL_CONFIG=/home/james/.config/fuzzel/sway-menu.ini

# Slots 2-5 are the hot ones and 1/6/7/8/10 are pinned by hand, so anything
# created or displaced lands at 11+ where $mod+Alt+N can still reach it.
PARK_FROM=11

ws_json() { swaymsg -t get_workspaces; }

ws_focused_name() { ws_json | jq -r '.[] | select(.focused) | .name'; }

# "15:chief/langfuse" -> "15"; a workspace never given a number yields "".
ws_num() { printf '%s' "${1%%:*}" | grep -x '[0-9]\+' || true; }

# "15:chief/langfuse" -> "chief/langfuse"; nameless workspaces yield themselves.
ws_label() {
    case "$1" in
        [0-9]*:*) label=${1#*:}; printf '%s' "${label# }" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Lowest unused number at or above PARK_FROM, so displaced work stays reachable.
ws_free_num() {
    used=$(ws_json | jq -r '.[].num')
    n=$PARK_FROM
    while printf '%s\n' "$used" | grep -qx "$n"; do n=$((n + 1)); done
    printf '%s' "$n"
}

# Live workspace names, most-recently-focused first, current one omitted.
# sway tracks no history of its own, so the order comes from sway-ws-mru, which
# records workspace ids rather than names: ids survive rename and promote, and
# both happen often enough that a name-keyed history would be wrong constantly.
ws_menu_list() {
    live=$(mktemp) || return 1
    ws_json | jq -r '.[] | select(.focused | not) | "\(.id)\t\(.name)"' > "$live"
    [ -f "$MRU_STATE" ] || : > "$MRU_STATE"
    awk -F'\t' '
        FNR == NR { name[$1] = $2; order[++n] = $1; next }
        ($0 in name) { print name[$0]; delete name[$0] }
        END { for (i = 1; i <= n; i++) if (order[i] in name) print name[order[i]] }
    ' "$live" "$MRU_STATE"
    rm -f "$live"
}

# Strip a leading icon, so the legacy "5: <glyph>" names shed theirs on rename.
# Icons live in waybar's format-icons now, not in the name. Matched as
# "non-alphanumeric run then space", so "new sync work" keeps its first word.
ws_strip_icon() {
    printf '%s' "$1" | sed 's/^[^[:alnum:][:space:]]\{1,\} //'
}

# waybar renders workspace labels as pango markup without escaping them, so a
# name containing & or <> would break the bar rather than show itself.
ws_sanitize() {
    printf '%s' "$1" | sed 's/&/+/g; s/[<>]//g'
}

ws_clean() { ws_sanitize "$(ws_strip_icon "$1")"; }

# Colons in a name separate the keyboard slot, the project, and what the
# project is for: "2:chief:v2-review". The menu breaks that apart -- slot in
# its own column, a chevron where the colons were, words title-cased -- because
# a column of raw "chief:" prefixes buries the part being read for.
WS_SEP=' › '
WAYBAR_CONFIG=/home/james/.config/waybar/config
WAYBAR_ICONS=/home/james/.config/waybar/workspace-icons.json

# Icon entries as "<label>\t<value>", straight out of waybar's own config.
# That file is JSON with comments, so jq cannot read it.
ws_config_icon_entries() {
    awk '
        /"format-icons"[[:space:]]*:[[:space:]]*\{/ { inmap = 1; next }
        inmap && /^[[:space:]]*\}/ { exit }
        inmap { if (split($0, f, "\"") >= 4) print f[2] "\t" f[4] }
    ' "$WAYBAR_CONFIG"
}

# The bar's icons as "<label>\t<glyph>". They sit in two files because waybar
# reads two: sway-ws-icon generates workspace-icons.json, and the tracked
# config holds the hand-written ones, which win over the include. Reading them
# in that order gives the menu the same precedence, since ws_display_map keeps
# the last entry seen for a label. A value whose first token is markup rather
# than a glyph ("focused", "default") is the format branch, not an icon.
ws_icon_map() {
    {
        [ -r "$WAYBAR_ICONS" ] && jq -r '
            ."sway/workspaces"."format-icons" // {}
            | to_entries[] | "\(.key)\t\(.value)"' "$WAYBAR_ICONS"
        [ -r "$WAYBAR_CONFIG" ] && ws_config_icon_entries
    } | awk -F'\t' '
        {
            glyph = $2
            sub(/^[[:space:]]+/, "", glyph)
            sub(/[[:space:]].*$/, "", glyph)
            if (glyph != "" && glyph !~ /^</) print $1 "\t" glyph
        }'
}

# Each line becomes "<display>\t<raw name>", so a pick can be mapped back.
ws_display_map() {
    _icons=$(mktemp) || return 1
    ws_icon_map > "$_icons"
    awk -v sep="$WS_SEP" -v iconfile="$_icons" '
        # Words that read as shouted initialisms, not names: "API V2 Planner"
        # rather than "Api V2 Planner".
        BEGIN {
            split("ai api cd ci cli cpu css csv db dns gpu html http" \
                  " https id ios json llm ml os pdf pr rss sql ssh tv ui url" \
                  " ux vpn", a, / /)
            for (i in a) acronym[a[i]] = 1
            while ((getline line < iconfile) > 0) {
                t = index(line, "\t")
                if (t) icon[substr(line, 1, t - 1)] = substr(line, t + 1)
            }
            close(iconfile)
        }

        # Title-case, dashes and underscores as word breaks. Only an ASCII
        # lower-case initial is touched, which leaves the legacy icon labels
        # alone rather than slicing a multi-byte glyph in half.
        function titleize(s,   n, i, w, c, out) {
            gsub(/[_-]+/, " ", s)
            n = split(s, w, / +/)
            out = ""
            for (i = 1; i <= n; i++) {
                if (w[i] == "") continue
                c = substr(w[i], 1, 1)
                if (tolower(w[i]) in acronym) w[i] = toupper(w[i])
                else if (c ~ /^[a-z]$/) w[i] = toupper(c) substr(w[i], 2)
                out = (out == "" ? w[i] : out " " w[i])
            }
            return out
        }
        {
            raw = $0
            n = split(raw, part, ":")
            slot = ""; first = 1
            if (part[1] ~ /^[0-9]+$/) { slot = part[1]; first = 2 }

            key = ""; label = ""
            for (i = first; i <= n; i++) {
                key = (key == "" ? part[i] : key ":" part[i])
                label = (label == "" ? titleize(part[i]) : label sep titleize(part[i]))
            }
            # A space where an icon would be, so the names stay in one column.
            glyph = (key in icon) ? icon[key] : " "

            if (label == "") display = slot
            else if (slot == "") display = glyph "  " label
            else display = sprintf("%2s  %s  %s", slot, glyph, label)
            printf "%s\t%s\n", display, raw
        }
    '
    rm -f "$_icons"
}

# Show the pretty form, hand back the real workspace name. Text that matched
# nothing is the user naming a new workspace, so it comes back as typed.
ws_pick() {
    _map=$(mktemp) || return 1
    ws_menu_list | ws_display_map > "$_map"
    _sel=$(cut -f1 "$_map" | fuzzel --dmenu --prompt="$1" --config="$FUZZEL_CONFIG")
    _rc=$?
    if [ "$_rc" -eq 0 ]; then
        _raw=$(awk -F'\t' -v s="$_sel" '$1 == s { print $2; exit }' "$_map")
        printf '%s' "${_raw:-$_sel}"
    fi
    rm -f "$_map"
    return "$_rc"
}
