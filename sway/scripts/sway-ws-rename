#!/bin/sh
# Rename the current workspace, keeping its number so keybindings and `assign`
# rules survive. The icon comes from ws-icons rather than waybar's
# format-icons, which matches whole names and so cannot cover projects that get
# invented on the fly.
set -u
. /home/james/.config/sway/scripts/sway-ws-lib

cur=$(ws_focused_name)
[ -n "$cur" ] || exit 1
num=$(ws_num "$cur")

label=$(ws_menu_list | fuzzel --dmenu --prompt='name: ' --config="$FUZZEL_CONFIG") || exit 0
[ -n "$label" ] || exit 0
label=$(ws_label "$label")

label=$(ws_decorate "$label")

if [ -n "$num" ]; then
    swaymsg rename workspace "$cur" to "$num:$label"
else
    swaymsg rename workspace "$cur" to "$(ws_free_num):$label"
fi
