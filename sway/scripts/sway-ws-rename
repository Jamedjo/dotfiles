#!/bin/sh
# Rename the current workspace, keeping its number so keybindings and `assign`
# rules survive.
set -u
. /home/james/.config/sway/scripts/sway-ws-lib

cur=$(ws_focused_name)
[ -n "$cur" ] || exit 1
num=$(ws_num "$cur")

label=$(ws_menu_list | fuzzel --dmenu --prompt='name: ' --config="$FUZZEL_CONFIG") || exit 0
[ -n "$label" ] || exit 0
label=$(ws_label "$label")

label=$(ws_clean "$label")

if [ -n "$num" ]; then
    swaymsg rename workspace "$cur" to "$num:$label"
else
    swaymsg rename workspace "$cur" to "$(ws_free_num):$label"
fi

# Pick an icon for the new name in the background: it takes a few seconds and
# the keybinding must not wait. Skips silently if the name already has one.
/home/james/.config/sway/scripts/sway-ws-icon "$label" >> "$HOME/.local/state/sway-ws-icon.log" 2>&1 &
