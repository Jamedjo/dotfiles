#!/usr/bin/env python3
"""Regenerate ws-icon-candidates: every named glyph the bar font actually has.

Two sources, because neither alone is enough:

  * the font's own post table -- authoritative about which glyphs exist, but
    312 of them in this range are named "_535" or "uniF0FF", which say nothing
    about what they draw. A model offered those can only choose blind, and did.
  * nerd-fonts' glyphnames.json -- names every one of them, but describes a
    newer patch than this font. Cross-checked before trusting: within
    U+F000-U+F2FF the two agree glyph for glyph (differing only as synonyms,
    "search" vs "magnifying_glass"), and a sample was rendered and eyeballed.

Outside that range they diverge -- U+f544 is a robot in Font Awesome 5, is
absent from glyphnames.json, and draws a down arrow here -- so the range stays.
"""
import json
import os
import re
import subprocess
import sys

FONT = "/home/james/.fonts/Ubuntu Nerd Font Complete.ttf"
OUT = "/home/james/.config/sway/scripts/ws-icon-candidates"
CACHE = os.path.expanduser("~/.cache/nerd-fonts-glyphnames.json")
URL = "https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/glyphnames.json"

from fontTools.ttLib import TTFont


def nerd_names():
    if not os.path.exists(CACHE):
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        if subprocess.run(["curl", "-sS", "-o", CACHE, URL]).returncode != 0:
            print("could not fetch glyph names; font names only", file=sys.stderr)
            return {}
    out = {}
    for key, val in json.load(open(CACHE)).items():
        if key == "METADATA" or not isinstance(val, dict) or "code" not in val:
            continue
        out.setdefault(int(val["code"], 16), key.replace("fa-", ""))
    return out


placeholder = lambda n: n.startswith("uni") or n.lstrip("_").isdigit()

cmap = TTFont(FONT, fontNumber=0, lazy=True).getBestCmap()
extra = nerd_names()
seen, rows, recovered = set(), [], 0
for cp, name in sorted(cmap.items()):
    if not 0xF000 <= cp <= 0xF2FF:
        continue
    if placeholder(name):
        name = extra.get(cp)
        if not name:
            continue
        recovered += 1
    name = re.sub(r"[^a-z0-9_]", "", name.split("#")[0].lower())
    if not name or name in seen:
        continue
    seen.add(name)
    rows.append("%04x %s" % (cp, name))

with open(OUT, "w") as fh:
    fh.write("# Icon candidates for sway-ws-icon, generated by sway-ws-icons-build.\n"
             "# <codepoint> <name>, for glyphs this font actually contains.\n")
    fh.write("\n".join(rows) + "\n")
print("wrote %d candidates (%d names recovered from glyphnames.json)"
      % (len(rows), recovered), file=sys.stderr)
