#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    swaybar_command waybar
}

# See: https://github.com/Alexays/Waybar/issues/63
for_window [app_id="waybar" floating] {
    #move position cursor
    #move down 158px # Adjust manually so menus fit
    move absolute position 1630 25
}

gaps inner 8
gaps outer 3
# Off, not on: the bar floats inset from the screen edge, so a lone window that
# sits flush to it is the one thing on screen not lining up with anything.
smart_gaps off
smart_borders on
# --i3 is the half that matters here: it drops the title bar on a tabbed or
# stacked container holding one child, which is where the second, redundant
# title bar was coming from. `smart` on its own only handles the screen edges.
hide_edge_borders --i3 smart
focus_follows_mouse no

# Inter, to match the bar. sway caches each container's title texture, so
# changing this at runtime needs `swaymsg '[title=".*"] title_format "%title"'`
# after it to force existing windows to re-render.
font pango:Inter Medium 10
titlebar_padding 12 5

# Chief, on waybar's palette rather than near it, and on waybar's grammar too:
# fill means current, outline means shouting. The bar draws its active
# workspace as the site's filled CTA - solid --color-primary-deep #256aba under
# white - and its urgent one as .badge-early, a gold letter inside a gold
# hairline with nothing behind it. Two different channels, so neither can be
# mistaken for the other however loud the gold gets.
#
# So the focused title is that CTA verbatim: #256aba edge to edge, #ffffff on
# top. An earlier pass tried to carry focus on the --bg-section -> --bg-elevated
# lift alone, #1a2d4f against #0f1f38, and it lost - with an urgent window on
# screen the gold was the only thing wearing real colour, so the gold read as
# the current one. A fill has to be a fill.
#
# Outlines stay quiet, which is the point of putting the signal in the fill.
# The ring around the focused window is #275288 - waybar's --nav-border
# rgba(74, 158, 255, .4) flattened onto --nav-ground, the same hairline the bar
# draws around its cards - and the title takes no edge of its own, so the bar
# reads as one solid block rather than a block inside a border.
# --color-primary #4a9eff survives only in the split indicator, which is a few
# pixels on one side and wants to be seen.
#
# Text is waybar's white ramp flattened the same way: .72 alpha #bcc0c7 for a
# title that is present but not current, .52 #8c93a0 for one that is neither.
# Urgent is .badge-early verbatim, the gold-on-ground letter inside a gold
# hairline that the bar already uses - not the red, which the bar spends on
# battery and network failure.
#
# class                 border    backgr.   text    indicator child_border
client.focused          #256aba   #256aba   #ffffff #4a9eff   #275288
client.focused_inactive #1a2d4f   #0f1f38   #bcc0c7 #1a2d4f   #16294a
client.unfocused        #16294a   #0f1f38   #8c93a0 #16294a   #16294a
client.urgent           #f0b35e   #0f1f38   #f0b35e #f0b35e   #f0b35e

