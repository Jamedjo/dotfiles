// Chief — waybar in chief-site's nav.
//
// Two ideas from the site drive the layout:
//   1. The nav is a card, not a strip. modules-left and modules-right are two
//      floating islands in the nav's own .drop treatment; the window title
//      floats between them with no chrome, so the bar has air in it.
//   2. The nav has a dropdown. group/system is that dropdown as a drawer: cpu
//      is the face, memory and temperature slide out from under it on hover.
//      It opens leftwards so it grows into the bar rather than shoving the
//      clock off the end.
[
    {
        "layer": "top",
        "height": 31,
        "modules-left": [
            "sway/workspaces",
            "sway/mode",
            "sway/scratchpad",
            "custom/media"
        ],
        "modules-center": [
            "sway/window"
        ],
        "modules-right": [
            "group/system",
            "wireplumber",
            "pulseaudio",
            "network",
            "battery",
            "tray",
            "clock"
        ],
        // {index} is sway's workspace number; {name} is the label with the
        // number already stripped.
        //
        // The dangling </span> is deliberate. waybar renders each label as
        // pango markup, and format-icons values are arbitrary strings, so an
        // icon that ends with an unclosed <span size="1"> shrinks the name
        // that follows it to nothing -- which is how a workspace shows its
        // icon INSTEAD of its name. "default" opens a plain span, so anything
        // without an icon renders normally. format itself cannot branch per
        // workspace; this is the branch.
        //
        // Adding an icon means adding a line here and `pkill -SIGUSR2 waybar`.
        // Names are matched exactly -- no prefixes -- so each workspace gets
        // its own icon rather than sharing one per project.
        "sway/workspaces": {
            "all-outputs": true,
            "format": "{index} {icon}{name}</span>",
            "format-icons": {
            // Checked before any name, so the focused workspace shows its name
            // in full while every other one stays an icon -- you always know
            // where you are without hovering.
            "focused":                "<span>",
            "meetings":               "  <span size=\"1\">",  // video camera
            "email":                  "  <span size=\"1\">",  // envelope
            "slack":                  "  <span size=\"1\">",  // slack
            "todos":                  "  <span size=\"1\">",  // task list
            "dump":                   "  <span size=\"1\">",  // trash
            "chief:v2-review":        "  <span size=\"1\">",  // code branch
            "chief:api-v2":           "  <span size=\"1\">",  // server
            "chief:api-planner":      "  <span size=\"1\">",  // calendar
            "chief:ask-tool":         "  <span size=\"1\">",  // cogs
            "chief:brand":            "  <span size=\"1\">",  // paint brush
            "chief:stripe":           "  <span size=\"1\">",  // credit card
            "chief:replace-llama":    "  <span size=\"1\">",  // microchip
            "productivity:sway":      "  <span size=\"1\">",  // terminal
            "productivity:new-phone": "  <span size=\"1\">",  // mobile
            "chief:hubspot":          "  <span size=\"1\">",  // address card
            "chief:llm-dump":         "  <span size=\"1\">",  // robot
            "default": "<span>"
            }
        },

        "sway/mode": {
            "format": "{}"
        },
        "sway/scratchpad": {
            "format": "{icon} {count}",
            "show-empty": false,
            "format-icons": [
                "",
                ""
            ],
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "sway/window": {
            "tooltip": false,
            "max-length": 90
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
            // Checked before any name, so the focused workspace shows its name
            // in full while every other one stays an icon -- you always know
            // where you are without hovering.
            "focused":                "<span>",
                "activated": "",
                "deactivated": ""
            }
        },
        "tray": {
            "spacing": 10
        },
        "clock": {
            "tooltip-format": "{:%Y-%m-%d | %H:%M}",
            "format": "{:%H:%M}",
            "format-alt": "{:%Y-%m-%d}"
        },
        "cpu": {
            "on-click": "foot -e htop",
            "format": " {usage}%"
        },
        "memory": {
            "format": " {}%"
        },
        "temperature": {
            "critical-threshold": 80,
            "format": "{temperatureC}°C "
        },
        "backlight": {
            "format": "{percent}% {icon}",
            "format-icons": [
                "",
                ""
            ]
        },
        "battery": {
            "bat": "BAT0",
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "on-click": "foot -e bash -c 'watch --no-title acpi -b'",
            "tooltip": true
        },
        "battery#bat2": {
            "bat": "BAT2"
        },
        "network": {
            "on-click": "foot -e nmtui",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)",
            "format-wifi": "",
            "format-disconnected": ""
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "{volume}% {icon}",
            "format-muted": "",
            "format-icons": {
            // Checked before any name, so the focused workspace shows its name
            // in full while every other one stays an icon -- you always know
            // where you are without hovering.
            "focused":                "<span>",
                "headphones": "",
                "handsfree": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "pavucontrol"
        },
        "wireplumber": {
            "format": "{volume}%",
            "format-muted": "",
            "on-click": "helvum"
        },
        "custom/media": {
            "format": "{icon} {}",
            "return-type": "json",
            "max-length": 40,
            "format-icons": {
            // Checked before any name, so the focused workspace shows its name
            // in full while every other one stays an icon -- you always know
            // where you are without hovering.
            "focused":                "<span>",
                "spotify": "",
                "default": "🎜"
            },
            "escape": true,
            "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null"
        },
        "spacing": 0,
        "reload_style_on_change": true,
        "group/system": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 300,
                "children-class": "drawer-child",
                "transition-left-to-right": false
            },
            "modules": [
                "cpu",
                "memory",
                "temperature"
            ]
        }
    },
    {
        "name": "focuslock",
        "position": "bottom",
        "layer": "top",
        "height": 31,
        "modules-left": [
            "custom/focuslock"
        ],
        "modules-right": [
            "custom/todoist"
        ],
        "custom/focuslock": {
            "tooltip": false,
            "max-length": 140,
            "restart-interval": 5,
            "return-type": "json",
            "exec": "$HOME/.config/waybar/focuslock-module.rb $HOME/.config/focuslock/current",
            "on-click": "foot -e bash -c 'sleep 0.1 && vim $HOME/.config/focuslock/current'"
        },
        "custom/todoist": {
            "tooltip": false,
            "max-length": 140,
            "restart-interval": 60,
            "return-type": "json",
            "exec": "PATH=/home/james/.rbenv/shims:$PATH ~/.config/waybar/todoist-module.rb '#MindfulChef'"
        },
        "spacing": 0,
        "reload_style_on_change": true
    }
]
