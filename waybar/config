// Chief — waybar in chief-site's nav.
//
// Two ideas from the site drive the layout:
//   1. The nav is a card, not a strip. modules-left and modules-right are two
//      floating islands in the nav's own .drop treatment; the window title
//      floats between them with no chrome, so the bar has air in it.
//   2. The nav has a dropdown. group/system is that dropdown as a drawer: cpu
//      is the face, memory and temperature slide out from under it on hover.
//      It opens leftwards so it grows into the bar rather than shoving the
//      clock off the end.
[
    {
        "layer": "top",
        "height": 31,
        // Per-workspace icons live here, written by sway-ws-icon. waybar merges
        // included objects key by key into this bar, and anything set here wins
        // over the include -- so "default" stays above, and a hand-written
        // icon in this file would override a generated one.
        "include": ["/home/james/.config/waybar/workspace-icons.json"],
        "modules-left": [
            "sway/workspaces",
            "sway/mode",
            "sway/scratchpad",
            "custom/media"
        ],
        "modules-right": [
            "group/system",
            "wireplumber",
            "pulseaudio",
            "network",
            "battery",
            "tray",
            "clock"
        ],
        // {index} is sway's workspace number; {name} is the label with the
        // number already stripped.
        //
        // The unbalanced spans are deliberate. A button is one pango string,
        // and format cannot branch per workspace, so the icon/name split is
        // spliced together here: format opens a span that pins {index} and the
        // icon at 11520 (11.25pt, the 15px the bar is set in), and every icon
        // in workspace-icons.json closes it and opens a plain span for the
        // name, which format's trailing </span> closes. That second span is
        // the only part inheriting the button's CSS font-size -- style.css
        // shrinks it to nothing unless the button is .focused, so the focused
        // workspace reads "15  icon Name" and the rest are their icon alone.
        // "default" closes and re-pins instead, so a workspace with no icon
        // still shows its name from anywhere.
        //
        // CSS has to carry the focused/unfocused branch because format-icons
        // cannot: it matches "focused" ahead of any workspace name, so a
        // "focused" entry here would mean the focused workspace could not also
        // have an icon of its own -- which is exactly what we want it to have.
        //
        // Adding an icon means adding a line there and `pkill -SIGUSR2 waybar`.
        // Names are matched exactly -- no prefixes -- so each workspace gets
        // its own icon rather than sharing one per project.
        "sway/workspaces": {
            "all-outputs": true,
            "format": "<span size=\"11520\">{index} {icon}{name}</span>",
            "format-icons": {
            "default":                "</span><span size=\"11520\" text_transform=\"capitalize\"> "
            }
        },

        "sway/mode": {
            "format": "{}"
        },
        "sway/scratchpad": {
            "format": "{icon} {count}",
            "show-empty": false,
            "format-icons": [
                "",
                ""
            ],
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "tray": {
            "spacing": 10
        },
        "clock": {
            "tooltip-format": "{:%Y-%m-%d | %H:%M}",
            "format": "{:%H:%M}",
            "format-alt": "{:%Y-%m-%d}"
        },
        "cpu": {
            "on-click": "foot -e htop",
            "format": " {usage}%"
        },
        "memory": {
            "format": " {}%"
        },
        "temperature": {
            "critical-threshold": 80,
            "format": "{temperatureC}°C "
        },
        "backlight": {
            "format": "{percent}% {icon}",
            "format-icons": [
                "",
                ""
            ]
        },
        "battery": {
            "bat": "BAT0",
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "on-click": "foot -e bash -c 'watch --no-title acpi -b'",
            "tooltip": true
        },
        "battery#bat2": {
            "bat": "BAT2"
        },
        "network": {
            "on-click": "foot -e nmtui",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)",
            "format-wifi": "",
            "format-disconnected": ""
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "{volume}% {icon}",
            "format-muted": "",
            "format-icons": {
                "headphones": "",
                "handsfree": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "pavucontrol"
        },
        "wireplumber": {
            "format": "{volume}%",
            "format-muted": "",
            "on-click": "helvum"
        },
        "custom/media": {
            "format": "{icon} {}",
            "return-type": "json",
            "max-length": 40,
            "format-icons": {
                "spotify": "",
                "default": "🎜"
            },
            "escape": true,
            "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null"
        },
        "spacing": 0,
        "reload_style_on_change": true,
        "group/system": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 300,
                "children-class": "drawer-child",
                "transition-left-to-right": false
            },
            "modules": [
                "cpu",
                "memory",
                "temperature"
            ]
        }
    },
    {
        "name": "focuslock",
        "position": "bottom",
        "layer": "top",
        "height": 31,
        "modules-left": [
            "custom/focuslock"
        ],
        // The window title lives here, not in the nav card above. It is
        // context rather than status -- what you are looking at, next to what
        // you meant to be doing -- so it belongs beside focuslock and todoist
        // rather than among the readouts. style.css gives it a capsule so it
        // does not read as a third sentence on a bar of prose.
        "modules-center": [
            "sway/window"
        ],
        "modules-right": [
            "custom/todoist"
        ],
        "sway/window": {
            "tooltip": false,
            "max-length": 90
        },
        "custom/focuslock": {
            "tooltip": false,
            "max-length": 140,
            "restart-interval": 5,
            "return-type": "json",
            "exec": "$HOME/.config/waybar/focuslock-module.rb $HOME/.config/focuslock/current",
            "on-click": "foot -e bash -c 'sleep 0.1 && vim $HOME/.config/focuslock/current'"
        },
        "custom/todoist": {
            "tooltip": false,
            "max-length": 140,
            "restart-interval": 60,
            "return-type": "json",
            "exec": "PATH=/home/james/.rbenv/shims:$PATH ~/.config/waybar/todoist-module.rb '#MindfulChef'"
        },
        "spacing": 0,
        "reload_style_on_change": true
    }
]
