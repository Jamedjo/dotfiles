// Chief — waybar in chief-site's nav.
//
// Two ideas from the site drive the layout:
//   1. The nav is a card, not a strip. modules-left and modules-right are two
//      floating islands in the nav's own .drop treatment; the window title
//      floats between them with no chrome, so the bar has air in it.
//   2. The nav has a dropdown. group/system is that dropdown as a drawer: cpu
//      is the face, memory and temperature slide out from under it on hover.
//      It opens leftwards so it grows into the bar rather than shoving the
//      clock off the end.
[
    {
        "layer": "top",
        "height": 34,
        // Per-workspace icons live here, written by sway-ws-icon. waybar merges
        // included objects key by key into this bar, and anything set here wins
        // over the include -- so "default" stays above, and a hand-written
        // icon in this file would override a generated one.
        "include": ["/home/james/.config/waybar/workspace-icons.json"],
        "modules-left": [
            "sway/workspaces",
            "sway/mode",
            "sway/scratchpad"
        ],
        // The name of the workspace you are on leads the island, beside the
        // glyph that opens the menu it came from. cpu, memory and temperature
        // used to sit at the head of this list behind a drawer; they are
        // readouts you look at rather than glance at, so they moved into the
        // control center and the bar kept the things worth a glance --
        // sound, network, battery, tray, notifications, the time.
        // The clock is out of the card. Everything that is a readout sits in
        // group/stats, which is what wears the capsule; the time is the one
        // figure on the bar worth reading from across the room, so it stands
        // on the desktop at twice the size with nothing behind it.
        "modules-right": [
            "group/stats",
            "clock"
        ],
        "group/stats": {
            "orientation": "horizontal",
            "modules": [
                "custom/switchboard",
                "pulseaudio",
                "network",
                "battery",
                "tray",
                "custom/notification"
            ]
        },
        // {index} is sway's workspace number; {name} is the label with the
        // number already stripped.
        //
        // No {name} any more. The focused workspace used to expand to
        // "15  icon Name" while the rest showed a glyph alone, because the bar
        // was the only place a name could appear. sway-switchboard shows every
        // name now, so the buttons are all the same shape: slot and icon, no
        // one of them wider than the others.
        //
        // The spans are still unbalanced on purpose. A button is one pango
        // string and format cannot branch per workspace, so format opens a
        // span for {index} and a second for the glyph, every icon in
        // workspace-icons.json closes that one and opens a third, and
        // format's trailing </span> closes it. The third span is empty rather
        // than holding a name -- keeping it is what lets
        // workspace-icons.json stay exactly as sway-ws-icon writes it.
        //
        // The number and the glyph are a pair, not one string set twice: 7680
        // is 7.5pt (10px) against the glyph's 10752 (10.5pt, 14px), and the
        // number is drawn at 55% of the colour style.css gives the button,
        // which lands on @ink-faint over the card. alpha rather than a
        // foreground, because a foreground would survive onto the accent fill
        // and the current workspace needs both halves to turn white.
        //
        // Adding an icon means adding a line there and `pkill -SIGUSR2 waybar`.
        // Names are matched exactly -- no prefixes -- so each workspace gets
        // its own icon rather than sharing one per project.
        "sway/workspaces": {
            "all-outputs": true,
            "format": "<span size=\"7680\" weight=\"500\" alpha=\"55%\">{index}</span><span size=\"10752\"> {icon}</span>",
            "format-icons": {
            "default":                "</span><span size=\"10752\" text_transform=\"capitalize\"> "
            }
        },

        "sway/mode": {
            "format": "{}"
        },
        "sway/scratchpad": {
            "format": "{icon} {count}",
            "show-empty": false,
            "format-icons": [
                "",
                ""
            ],
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "tray": {
            // Spacing is the container's, so it too is paid on an empty tray.
            // The gap between items is padding on the items now; see #tray in
            // style.css.
            "spacing": 0
        },
        "clock": {
            "tooltip-format": "{:%Y-%m-%d | %H:%M}",
            "format": "{:%H:%M}",
            "format-alt": "{:%Y-%m-%d}"
        },
        "backlight": {
            "format": "{percent}% {icon}",
            "format-icons": [
                "",
                ""
            ]
        },
        "battery": {
            "bat": "BAT0",
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "<span alpha=\"69%\">{icon}</span> {capacity}%",
            "format-charging": "<span alpha=\"69%\"></span> {capacity}%",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "on-click": "foot -e bash -c 'watch --no-title acpi -b'",
            "tooltip": true
        },
        "battery#bat2": {
            "bat": "BAT2"
        },
        "network": {
            "on-click": "foot -e nmtui",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)",
            "format-wifi": "直",
            "format-disconnected": "睊"
        },
        // The icon is dimmed to @ink-dim and the figure left at @ink-soft,
        // which is the design's status grammar. It has to happen here: the
        // module is one label, so CSS can only colour both the same.
        "pulseaudio": {
            "format": "<span alpha=\"69%\">{icon}</span> {volume}%",
            "format-bluetooth": "{volume}% <span alpha=\"69%\">{icon}</span>",
            "format-muted": "婢",
            "format-icons": {
                "headphones": "",
                "handsfree": "",
                "headset": "",
                "phone": "",
                "portable": "蓼",
                "car": "",
                "default": [
                    "奄",
                    "奔",
                    "墳"
                ]
            },
            "on-click": "pavucontrol",
            "on-click-right": "helvum"
        },
        // Opens sway-switchboard, the cascading workspace menu, and says where
        // you are while it waits: "Chief > V2 Review", cased and chevroned the
        // same way the menu and the fuzzel picker do it. waybar-ws-current
        // subscribes to sway rather than polling, so this costs nothing
        // between workspace switches.
        //
        // It is the one place a workspace name still appears in the bar. The
        // buttons gave theirs up when the menu started showing every name.
        "custom/switchboard": {
            "tooltip": true,
            "return-type": "json",
            "format": "  {}",
            "max-length": 42,
            "exec": "$HOME/.config/sway/scripts/waybar-ws-current",
            "on-click": "sway-switchboard"
        },
        // The panel handle. It opens swaync's control center: the quick
        // toggles, the sliders, and the notification history. Sliders rather
        // Three sliders, the mark a control center conventionally wears --
        // macOS uses it -- because the panel is mostly not notifications: the
        // vitals, five toggles and six actions come before the list. It turns
        // into a struck bell under do-not-disturb, where that glyph means
        // exactly one thing, and the colour carries the unread state.
        // The click goes through that script rather than straight at
        // swaync-client because the menus are static config and have to be
        // rebuilt from sway before the panel is shown.
        //
        // -swb is a subscription, not a poll -- it prints a line when a
        // notification arrives or do-not-disturb flips -- so the bell fills
        // and empties with no interval set -- the colour carries the unread
        // state, see #custom-notification in style.css. Right-click toggles DND.
        //
        // It goes through swaync-panel rather than straight at swaync-client
        // because cpu, memory and temperature are written into swaync's config
        // and have to be refreshed before the panel is shown.
        "custom/notification": {
            "tooltip": true,
            "format": "{icon}",
            "format-icons": {
                "none": "",
                "notification": "",
                "dnd-none": "",
                "dnd-notification": "",
                "inhibited-none": "",
                "inhibited-notification": "",
                "dnd-inhibited-none": "",
                "dnd-inhibited-notification": ""
            },
            "return-type": "json",
            "exec": "swaync-client -swb",
            "exec-if": "which swaync-client",
            "on-click": "$HOME/.config/sway/scripts/swaync-panel toggle",
            "on-click-right": "swaync-client -d -sw",
            "escape": true
        },
        "spacing": 0,
        "reload_style_on_change": true
    },
    {
        "name": "focuslock",
        "position": "bottom",
        "layer": "top",
        "height": 31,
        "modules-left": [
            "custom/focuslock"
        ],
        // The window title lives here, not in the nav card above. It is
        // context rather than status -- what you are looking at, next to what
        // you meant to be doing -- so it belongs beside focuslock and todoist
        // rather than among the readouts. style.css gives it a capsule so it
        // does not read as a third sentence on a bar of prose.
        "modules-center": [
            "sway/window"
        ],
        "modules-right": [
            "custom/todoist"
        ],
        "sway/window": {
            "tooltip": false,
            "max-length": 90
        },
        "custom/focuslock": {
            "tooltip": false,
            "max-length": 140,
            "restart-interval": 5,
            "return-type": "json",
            "exec": "$HOME/.config/waybar/focuslock-module.rb $HOME/.config/focuslock/current",
            "on-click": "foot -e bash -c 'sleep 0.1 && vim $HOME/.config/focuslock/current'"
        },
        "custom/todoist": {
            "tooltip": false,
            "max-length": 140,
            "restart-interval": 60,
            "return-type": "json",
            "exec": "PATH=/home/james/.rbenv/shims:$PATH ~/.config/waybar/todoist-module.rb '#MindfulChef'"
        },
        "spacing": 0,
        "reload_style_on_change": true
    }
]
